OPENAI_API_KEY=
# Optional; without a key Semantic Scholar throttles hard and runs degrade with warnings.
S2_API_KEY=

# Everything the app writes at runtime — workspaces, pipeline artifacts,
# provider caches — lives under this root. Defaults to ./data.
# RESEARCH_TREE_DATA_DIR=

# ---- accounts ---------------------------------------------------------------
# `none` (the default) is the single implicit local user: only run it that way
# on loopback or behind a proxy that does its own sign-in. The container image
# sets `accounts`, which needs the database below plus SESSION_SECRET.
# RESEARCH_TREE_AUTH_MODE=none
# A random string of at least 32 characters (`openssl rand -hex 32`). Signs the
# Google sign-in state and, later, verification and reset tokens.
# SESSION_SECRET=
# Comma-separated emails allowed to register and sign in. Empty admits everyone.
# RESEARCH_TREE_ALLOWED_EMAILS=
# Comma-separated emails with operator rights in the app.
# RESEARCH_TREE_ADMIN_EMAILS=
# The origin the site is served from. Decides whether cookies are Secure, which
# host the Google callback returns to, and where `www.` is redirected.
# RESEARCH_TREE_PUBLIC_ORIGIN=http://localhost:5173
# Google sign-in is offered when both are set. The redirect URI registered with
# Google must be <public origin>/auth/google/callback (locally, through the
# dev proxy: http://localhost:5173/api/auth/google/callback).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# ---- storage ----------------------------------------------------------------
# Postgres selects the database repository; unset, workspaces are JSON files
# under the data directory. This is the Supabase *session pooler* string on
# port 5432 (never 6543) for the least-privilege app role; the owner DSN is
# only used by `research-tree-migrate`. `docker compose` sets its own.
# RESEARCH_TREE_DATABASE_URL=postgresql+psycopg://research_tree_app.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
# Large per-paper payloads (extracted text, annotations, PDFs, caches) go to
# Azure Blob Storage when this is set, reached through the container's managed
# identity; otherwise they are files under the data directory.
# RESEARCH_TREE_BLOB_ACCOUNT_URL=https://researchtree7.blob.core.windows.net
# RESEARCH_TREE_BLOB_CONTAINER=artifacts
# Redis: the job queue and shared rate-limit clock (phase 2).
# RESEARCH_TREE_REDIS_URL=rediss://:<access-key>@research-tree-cache.westus2.redis.azure.net:10000/0

# ---- serving ----------------------------------------------------------------
# Set to the built SPA directory to serve the web app from the API's origin;
# the container image sets /app/web.
# RESEARCH_TREE_WEB_DIR=
# Comma-separated origins allowed to call the API cross-origin. Leave empty
# when the Vite dev server proxies /api (the default) or the SPA is served by
# the API itself.
# RESEARCH_TREE_ALLOWED_ORIGINS=
# Where scripts/run_backend.sh binds. A container sets HOST to 0.0.0.0.
# RESEARCH_TREE_HOST=127.0.0.1
# RESEARCH_TREE_PORT=8000
# Frontend build-time var (Vite inlines it): the API origin the built bundle
# calls. Defaults to /api, which only works behind the dev proxy; the image
# builds with "" for same-origin paths.
# VITE_RESEARCH_TREE_API_BASE_URL=

# ---- tests (CI only) --------------------------------------------------------
# When set, every repository test runs a second time against this scratch
# database, which the suite wipes and rebuilds from the migrations.
# RESEARCH_TREE_TEST_DATABASE_URL=postgresql+psycopg://research_tree:research_tree@localhost:5432/research_tree_test

# ---- models -----------------------------------------------------------------
# Set to 0 to stop offering the assistant OpenAI's built-in web search.
# RESEARCH_TREE_AGENT_WEB_SEARCH=1

# Annotating a paper: which model reads it, how hard it thinks per passage, and
# how many passages run at once. Lower the effort to trade quality for cost.
# RESEARCH_TREE_ANNOTATION_MODEL=gpt-5.6-luna
# RESEARCH_TREE_ANNOTATION_EFFORT=high
# RESEARCH_TREE_ANNOTATION_CONCURRENCY=3

# How each passage is given the rest of the paper. `fast` groups the paper into
# sections and embeds them. `dense` describes every passage first, which costs a
# model call per passage and finds more.
# RESEARCH_TREE_ANNOTATION_RETRIEVAL=fast
