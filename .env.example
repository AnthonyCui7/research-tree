OPENAI_API_KEY=
# Optional; without a key Semantic Scholar throttles hard and runs degrade with warnings.
S2_API_KEY=

# Everything the app writes at runtime — workspaces, pipeline artifacts,
# provider caches — lives under this root. Defaults to ./data.
# RESEARCH_TREE_DATA_DIR=

# Comma-separated origins allowed to call the API. Leave empty when the Vite
# dev server proxies /api (the default); set it when the frontend is hosted
# separately.
# RESEARCH_TREE_ALLOWED_ORIGINS=

# Set to 0 to stop offering the assistant OpenAI's built-in web search.
# RESEARCH_TREE_AGENT_WEB_SEARCH=1
